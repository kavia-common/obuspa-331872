{"is_source_file": true, "format": "C header file", "description": "This file declares functions, macros, and constants related to managing error messages and error codes within a USP (Universal Service Platform) implementation. It provides mechanisms to set, retrieve, and handle error messages, especially in relation to SQL operations and system errors. It also includes macros for error handling and termination.", "external_files": ["usp_err_codes.h"], "external_methods": [], "published": ["USP_ERR_Init", "USP_ERR_SetMessage_Sql", "USP_ERR_SetMessage_SqlParam", "USP_ERR_ToString", "USP_ERR_UspErrToString", "USP_ERR_SetMessage_Errno", "USP_ERR_ClearMessage", "USP_ERR_ReplaceEmptyMessage", "USP_ERR_GetMessage", "USP_ERR_Terminate", "USP_ERR_Terminate_BadCase", "USP_ERR_Terminate_OnAssert"], "classes": [], "methods": [{"name": "USP_ERR_Init", "description": "Initializes the error handling system."}, {"name": "USP_ERR_SetMessage_Sql", "description": "Sets an error message related to an SQL function, recording function name, line, SQL function name, and database handle."}, {"name": "USP_ERR_SetMessage_SqlParam", "description": "Sets an error message related to an SQL operation with parameters, including function name, line, SQL function, and database handle."}, {"name": "USP_ERR_ToString", "description": "Converts an error code into a human-readable string, writing into provided buffer."}, {"name": "USP_ERR_UspErrToString", "description": "Converts a USP-specific error code into a string description."}, {"name": "USP_ERR_SetMessage_Errno", "description": "Sets an error message based on a system error number, with context of function, line, and failed function."}, {"name": "USP_ERR_ClearMessage", "description": "Clears any stored error message."}, {"name": "USP_ERR_ReplaceEmptyMessage", "description": "Replaces an empty error message with a formatted message."}, {"name": "USP_ERR_GetMessage", "description": "Retrieves the current error message."}, {"name": "USP_ERR_Termi