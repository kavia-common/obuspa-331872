{"is_source_file": true, "format": "C", "description": "This file implements a CoAP server component for handling USP (User Services Platform) messages, including setting up DTLS/CoAP sockets, managing sessions, processing CoAP PDUs (including block-wise transfers), and handling DTLS connections with optional encryption. It supports starting/stopping servers, managing multiple sessions, handling incoming CoAP requests, and security via OpenSSL.", "external_files": ["common_defs.h", "usp_coap.h", "usp_api.h", "usp-msg.pb-c.h", "msg_handler.h", "os_utils.h", "dllist.h", "dm_exec.h", "retry_wait.h", "text_utils.h", "nu_ipaddr.h", "iso8601.h", "usp-record.pb-c.h"], "external_methods": ["DEVICE_SECURITY_CreateSSLContext", "DEVICE_SECURITY_TrustCertVerifyCallback", "DEVICE_LOCAL_AGENT_GetDualStackPreference", "tw_ulib_get_dev_ipaddr", "nu_ipaddr_from_str", "nu_ipaddr_to_sockaddr", "nu_ipaddr_get_family", "nu_ipaddr_from_sockaddr_storage", "nu_ipaddr_str", "tw_ulib_diags_lookup_host", "USP_LOG_Error", "USP_LOG_ErrorSSL", "USP_LOG_Warning", "USP_LOG_Info", "USP_PROTOCOL", "USP_SAFE_FREE", "USP_REALLOC", "USP_ASSERT", "SOCKET_SET_AddSocketToReceiveFrom", "SOCKET_SET_UpdateTimeout", "SOCKET_SET_IsReadyToRead", "CDC_WaitAckEvent", "COAP_ParsePdu", "COAP_SendPdu", "COAP_WriteRst", "COAP_SetErrMessage", "StartCoapListenSock", "MTP_EXEC_CoapWakeup", "DM_EXEC_PostUspRecord", "USP_STRNCPY", "USP_STRDUP", "TEXT_UTILS_PercentDecodeString", "iso8601_cur_time"], "published": ["COAP_SERVER_Init", "COAP_SERVER_InitStart", "COAP_SERVER_Destroy", "COAP_SERVER_Start", "COAP_SERVER_Stop", "COAP_SERVER_GetStatus", "COAP_SERVER_UpdateAllSockSet", "COAP_SERVER_ProcessAllSocketActivity", "COAP_SERVER_AreNoOutstandingIncomingMessages"], "classes": [{"name": "coap_server_session_t", "description": "Structure representing a CoAP server session, managing individual client connections, DTLS state, session parameters, block transfer state, and received message buffers."}, {"name": "coap_server_t", "description": "Structure representing a CoAP server instance, including network interface, port, socket, and multiple concurrent sessions."}], "methods": [{"name": "int StartCoapListenSock(coap_server_t * cs)", "description": "Creates and binds a UDP socket on the specified interface and port for listening to incoming CoAP packets.", "scope": "", "scopeKind": ""}, {"name": "void InitCoapSession(coap_server_session_t * css)", "description": "Initializes a CoAP session structure with default values for a new session.", "scope": "", "scopeKind": ""}, {"name": "coap_server_session_t * FindCoapSession(coap_server_t * cs,nu_ipaddr_t * peer_addr)", "description": "Finds an available session slot for a new incoming connection, potentially shutting down an old session.", "scope": "", "scopeKind": ""}, {"name": "int PerformSessionDtlsConnect(coap_server_session_t * css)", "description": "Performs the DTLS handshake for a new CoAP session, setting up SSL and BIO objects, and completing the DTLS handshake.", "scope": "", "scopeKind": ""}, {"name": "void StopCoapSession(coap_server_session_t * css)", "description": "Gracefully closes a session, freeing SSL objects, closing sockets, and freeing buffers.", "scope": "", "scopeKind": ""}, {"name": "void ReceiveCoapBlock(coap_server_t * cs,coap_server_session_t * css)", "description": "Reads a block of a USP message over CoAP, handling block-wise transfer, parsing the PDU, and managing session state.", "scope": "", "scopeKind": ""}, {"name": "unsigned CalcCoapServerActions(coap_server_t * cs,coap_server_session_t * css,parsed_pdu_t * pp)", "description": "Determines what actions to take upon receiving a CoAP PDU (e.g., send ACK, RST, block handling).", "scope": "", "scopeKind": ""}, {"name": "unsigned AppendCoapPayload(coap_server_session_t * css,parsed_pdu_t * pp)", "description": "Appends received payload to the session's buffer for message reassembly.", "scope": "", "scopeKind": ""}, {"name": "bool IsReplyToValid(coap_server_session